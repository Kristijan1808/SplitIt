generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupAccessType {
  ANONYMOUS_ONLY
  REGISTERED_ONLY
  MIXED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedGroups Group[]       @relation("GroupOwner")
  memberships GroupMember[]

  @@map("users")
}

model Group {
  id           String          @id @default(uuid())
  name         String
  slug         String          @unique
  code         String          @unique
  locked       Boolean         @default(false)
  accessType   GroupAccessType @default(ANONYMOUS_ONLY)
  passwordHash String          @default("")
  ownerUserId  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  owner         User?          @relation("GroupOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  members       GroupMember[]
  people        Person[]
  expenses      Expense[]
  history       History[]
  draftExpenses ExpenseDraft[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model Person {
  id        String   @id @default(uuid())
  name      String
  groupId   String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Finalized expenses
  expensePayers ExpensePayer[]
  expenseShares ExpenseShare[]
  itemShares    ExpenseItemShare[]

  // Draft expenses
  draftPayers     ExpenseDraftPayer[]
  draftItemShares ExpenseDraftItemShare[]

  @@map("people")
}

//
// =========================
// FINALIZED EXPENSE
// =========================
//

model Expense {
  id          String   @id @default(uuid())
  groupId     String
  totalAmount Decimal  @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payers ExpensePayer[]
  items  ExpenseItem[]
  shares ExpenseShare[]

  @@map("expenses")
}

//
// =========================
// WHO PAID THE EXPENSE
// =========================
//

model ExpensePayer {
  id        String   @id @default(uuid())
  expenseId String
  personId  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([expenseId, personId])
  @@map("expense_payers")
}

//
// =========================
// EXPENSE ITEMS
// =========================
//

model ExpenseItem {
  id            String   @id @default(uuid())
  expenseId     String
  ordinalNumber Int
  name          String
  price         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expense Expense              @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  shares  ExpenseItemShare[]

  @@unique([expenseId, ordinalNumber])
  @@map("expense_items")
}

//
// =========================
// WHO OWES AN ITEM
// =========================
//
// Example:
//
// Pizza €20
//
// John  €10
// Sarah €10
//
// The amount does not have to be equal.
// It can also be:
//
// John  €5
// Sarah €15
//

model ExpenseItemShare {
  id        String   @id @default(uuid())
  itemId    String
  personId  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item   ExpenseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  person Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([itemId, personId])
  @@map("expense_item_shares")
}

//
// =========================
// TOTAL AMOUNT OWED
// =========================
//
// This is the aggregated amount per person.
//
// Example:
//
// John owes €32.50
// Sarah owes €37.50
// Mark owes €30
//
// It is derived from ExpenseItemShare records
// when the draft is confirmed.
//

model ExpenseShare {
  id        String   @id @default(uuid())
  expenseId String
  personId  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([expenseId, personId])
  @@map("expense_shares")
}

//
// =========================
// EXPENSE DRAFT
// =========================
//

model ExpenseDraft {
  id        String   @id @default(uuid())
  groupId   String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group  Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payers ExpenseDraftPayer[]
  items  ExpenseDraftItem[]

  @@map("expense_drafts")
}

//
// =========================
// DRAFT PAYERS
// =========================
//
// Example:
//
// Mark       €20
// Kristijan  €80
//
// Total = €100
//

model ExpenseDraftPayer {
  id        String   @id @default(uuid())
  draftId   String
  personId  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draft  ExpenseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  person Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([draftId, personId])
  @@map("expense_draft_payers")
}

//
// =========================
// DRAFT ITEMS
// =========================
//
// Items can initially have NO shares.
//
// Example:
//
// Pizza €20
// Beer  €10
// Salad €15
//
// Nobody has selected anything yet.
//
// Later people can select the items.
//

model ExpenseDraftItem {
  id            String   @id @default(uuid())
  draftId       String
  ordinalNumber Int
  name          String
  price         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  draft  ExpenseDraft           @relation(fields: [draftId], references: [id], onDelete: Cascade)
  shares ExpenseDraftItemShare[]

  @@unique([draftId, ordinalNumber])
  @@map("expense_draft_items")
}

//
// =========================
// DRAFT ITEM SHARES
// =========================
//
// This is the important part.
//
// One item can belong to:
// - nobody yet
// - one person
// - multiple people
//
// Example:
//
// Pizza €20
//
// John  €10
// Sarah €10
//
// OR:
//
// Pizza €20
//
// John  €20
//
// OR:
//
// Pizza €20
//
// John  €5
// Sarah €15
//

model ExpenseDraftItemShare {
  id        String   @id @default(uuid())
  itemId    String
  personId  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item   ExpenseDraftItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  person Person           @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([itemId, personId])
  @@map("expense_draft_item_shares")
}

//
// =========================
// HISTORY
// =========================
//

model History {
  id        String   @id @default(uuid())
  groupId   String
  action    String
  entity    String
  entityId  String?
  message   String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("history")
}